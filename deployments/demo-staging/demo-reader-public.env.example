# Safe public configuration for the SEPARATE Render Demo reader Cron Job.
# This file contains no usable credentials. Keep REFRESH_ENABLED=false during setup.
NODE_VERSION=24
NIGHT_SCOUT_RUNTIME_ENV=staging
NIGHT_SCOUT_DEMO_XERO_REFRESH_ENABLED=false
NIGHT_SCOUT_DEMO_XERO_PROJECT_REF=bioalckltvkhlczusdvl
NIGHT_SCOUT_DEMO_XERO_STORE_ID=f59e3a44-7106-4df8-9c08-52da30c9de30
NIGHT_SCOUT_DEMO_XERO_PERIOD_MODE=daily_completed_period
NIGHT_SCOUT_DEMO_XERO_CURRENCY=GBP

# Add these privately through the approved host setup; intentionally no assignments:
# NIGHT_SCOUT_DEMO_XERO_CLIENT_ID
# NIGHT_SCOUT_DEMO_XERO_CLIENT_SECRET
# NIGHT_SCOUT_DEMO_XERO_EXPECTED_TENANT_ID
# NIGHT_SCOUT_DEMO_XERO_ENVELOPE_MASTER_KEY
# NIGHT_SCOUT_DEMO_XERO_ENVELOPE_KEY_VERSION
# NIGHT_SCOUT_DEMO_XERO_DATABASE_URL
# NIGHT_SCOUT_DEMO_XERO_CA_PEM
# Dedicated new reader app, master key and restricted database login only.
# Do not import old reader, writer, consent host or Shopify environment groups.

# Render source root: repository root; runtime Node 24.
# Build command:
# node deployments/demo-staging/prepare-demo-reader-deployment.mjs .render-demo-reader && pnpm --dir .render-demo-reader install --config.auto-install-peers=false --frozen-lockfile --ignore-workspace --prod --ignore-scripts
# Start command:
# node .render-demo-reader/deployments/demo-staging/run-demo-daily-cron.mjs
# Cron schedule (UTC): 0 1,2 * * *
# Actual runtime additionally admits only 02:00-02:14 Europe/London.
# Fixed intake expires 2026-11-06T03:00:00Z; hosting billing is not cancelled by expiry.
